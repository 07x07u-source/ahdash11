# Browser-safe Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Enables local fallback data and import simulation when Supabase is absent.
# Never enable this in production.
ADMIN_DEV_BYPASS_AUTH=true

# Demo rows are opt-in and never replace a failed live query silently.
ADMIN_USE_DEMO_DATA=false

# Optional trusted origin used in metadata and redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
