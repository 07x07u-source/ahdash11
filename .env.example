# -----------------------------------------------------------------------------
# Shared / Supabase
# Copy the relevant values to mobile/.env and admin/.env.local. Never commit them.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_NEVER_SHIP_TO_MOBILE
APP_ENV=development

# Public product URLs
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms
APP_DEEP_LINK_SCHEME=com.ahdash.eleven
APP_UNIVERSAL_LINK_HOST=play.example.com
ADMIN_URL=http://localhost:3000

# Firebase Android (values are not private, but keep per-environment)
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_PROJECT_ID=

# Firebase iOS
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_MESSAGING_SENDER_ID=
FIREBASE_IOS_PROJECT_ID=
FIREBASE_IOS_BUNDLE_ID=com.ahdash.eleven
FIREBASE_ENABLED=false

# Public authentication feature flags used with --dart-define
GOOGLE_AUTH_ENABLED=false
APPLE_AUTH_ENABLED=false

# RevenueCat public SDK keys
REVENUECAT_ANDROID_API_KEY=
REVENUECAT_IOS_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium

# AdMob public ad unit identifiers. Use Google's test IDs during development.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
ADMOB_REWARDED_ANDROID_ID=
ADMOB_REWARDED_IOS_ID=
ADMOB_INTERSTITIAL_ANDROID_ID=
ADMOB_INTERSTITIAL_IOS_ID=
ADMOB_INTERSTITIAL_EVERY_MATCHES=3
ADMOB_ENABLED=false

# Admin (NEXT_PUBLIC values are exposed to the browser by design)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Edge Functions / provider secrets (set with `supabase secrets set`, not in files)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
REVENUECAT_WEBHOOK_AUTH=
NOTIFICATION_DISPATCH_SECRET=
ADMOB_REWARD_ITEM=coins
