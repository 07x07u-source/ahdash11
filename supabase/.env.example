# Used only by Edge Functions. Supabase injects the first three automatically when deployed.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Comma-separated web origins; mobile bearer requests do not depend on browser CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Provider integrations. Use non-production credentials locally.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
NOTIFICATION_DISPATCH_SECRET=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=premium
ADMOB_REWARDED_ANDROID_ID=
ADMOB_REWARDED_IOS_ID=
ADMOB_REWARD_ITEM=coins
